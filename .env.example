# Where the Express API runs. Used server-side only by the /api rewrite in next.config.ts.
# Local: http://localhost:4000 · Production: your Render URL, e.g. https://doctortracker-server.onrender.com
API_URL=http://localhost:4000

# Must be the SAME value as the server's JWT_SECRET — proxy.ts uses it to verify the session cookie.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
COOKIE_NAME=dt_session

# Optional: show + prefill demo credentials on the sign-in page.
NEXT_PUBLIC_DEMO_EMAIL=admin@doctortracker.app
NEXT_PUBLIC_DEMO_PASSWORD=Admin@12345
